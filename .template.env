# Database
MYSQL_URL=localhost:3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=kaellybot

# Amqp
RABBITMQ_ADDRESS=amqp://localhost:5672

# Dofus Touch client data
TOUCH_CONFIG_URL=https://dt-proxy-production-login.ankama-games.com/config.json
TOUCH_LANGUAGES=fr,en,es,pt
TOUCH_USER_AGENT=KaellyBot-Gamedata/1.0 (+https://github.com/kaellybot/kaelly-gamedata)

# Krosmoz almanax
KROSMOZ_ALMANAX_URL=https://www.krosmoz.com/%s/almanax/%s
KROSMOZ_LANGUAGE=fr
KROSMOZ_USER_AGENT=KaellyBot-Gamedata/1.0 (+https://github.com/kaellybot/kaelly-gamedata)
ALMANAX_REFRESH_INTERVAL=168h
KROSMOZ_DAYS_PER_RUN=31

# Import
MAX_DELETED_RATIO=0.05
SNAPSHOT_RETENTION=10
STORAGE_PATH=/data
CDN_BASE_URL=https://cdn.kaellybot.com/
HTTP_TIMEOUT=60s
DRY_RUN=false

# Miscellaneous
METRIC_PORT=2112
LOG_LEVEL=info # trace, debug, info, warn, error, fatal, panic
PRODUCTION=false
